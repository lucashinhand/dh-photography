---
import '../styles/global.css';
import { siteOrigin } from '../lib/deployment';

import { navPages, route, site, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  pageKind?: string;
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.description || site.name,
  canonicalPath = '/',
  image,
  pageKind = 'page',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const origin = siteOrigin;
const canonical = new URL(
  canonicalPath.endsWith('.html')
    ? withBase(canonicalPath, base)
    : route(canonicalPath, base),
  origin,
).toString();
const imageUrl = image
  ? new URL(withBase(image, base), origin).toString()
  : undefined;
const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const pages = navPages();
const galleries = pages.filter((page) => page.kind === 'gallery');
const informational = pages.filter((page) => page.kind !== 'gallery');
const currentPath = Astro.url.pathname;
const homePaths = new Set([route('/', base), route('portfolio', base)]);
const galleryPaths = new Set(galleries.map((page) => route(page.slug, base)));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBase('/favicon.svg', base)}
    />
    <meta
      property="og:type"
      content={pageKind === 'gallery' ? 'article' : 'website'}
    />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta
      name="twitter:card"
      content={imageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <title>{pageTitle}</title>
  </head>
  <body class={`site-body ${pageKind}-page`}>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="site-header__inner">
        <a
          class="wordmark"
          href={route('/', base)}
          aria-label={`${site.name}, home`}
        >
          <span class="wordmark__name">{site.name}</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          <a
            class="site-nav__home"
            href={route('/', base)}
            aria-current={homePaths.has(currentPath) ? 'page' : undefined}
          >
            Work
          </a>
          {galleries.length > 0 && (
            <details class="site-nav__menu">
              <summary
                aria-current={
                  galleryPaths.has(currentPath) ? 'page' : undefined
                }
              >
                Galleries
              </summary>
              <div class="site-nav__menu-panel">
                {galleries.map((page) => (
                  <a
                    href={route(page.slug, base)}
                    aria-current={
                      currentPath === route(page.slug, base)
                        ? 'page'
                        : undefined
                    }
                  >
                    {page.title}
                  </a>
                ))}
              </div>
            </details>
          )}
          {informational.map((page) => (
            <a
              href={route(page.slug, base)}
              aria-current={
                currentPath === route(page.slug, base) ? 'page' : undefined
              }
            >
              {page.title}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>© 2026 David Hahn Photography</span>
        <span>All rights reserved</span>
        <a href={route('contact', base)}>Get in touch</a>
      </div>
    </footer>
  </body>
</html>
